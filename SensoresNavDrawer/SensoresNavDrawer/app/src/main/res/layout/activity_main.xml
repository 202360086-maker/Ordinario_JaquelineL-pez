<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio estilo BENTO: tarjetas de distintos tamaños con datos en vivo -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView style="@style/TextoEtiqueta" android:text="En vivo" />
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/circulo"
                android:backgroundTint="@color/primario" />
        </LinearLayout>

        <TextView style="@style/TextoGrande" android:layout_marginTop="4dp" android:text="Panel de sensores" />

        <TextView
            android:id="@+id/tvDisponibles"
            style="@style/TextoDescripcion"
            android:layout_marginBottom="18dp"
            android:text="Revisando sensores..." />

        <!-- MAGNETÓMETRO (tarjeta ancha) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMag"
            style="@style/TarjetaSensor">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/imgBrujulaMini"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:contentDescription="Brújula"
                    android:src="@drawable/ic_brujula" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:orientation="vertical">
                    <TextView style="@style/TextoEtiqueta" android:text="Magnetómetro" />
                    <TextView android:id="@+id/tvRumboMini" style="@style/TextoGrande" android:text="--° N" />
                    <TextView
                        android:id="@+id/tvMagMini"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- µT"
                        android:textColor="@color/primario"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FILA: ACELERÓMETRO + GIROSCOPIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAcel"
                style="@style/TarjetaSensor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="7dp"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/TextoEtiqueta" android:text="Acelerómetro" />
                    <!-- Barras que crecen desde abajo -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <View android:id="@+id/barra1" android:layout_width="9dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:background="@drawable/barra" android:backgroundTint="@color/gris_barra" />
                        <View android:id="@+id/barra2" android:layout_width="9dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:background="@drawable/barra" android:backgroundTint="@color/gris_barra" />
                        <View android:id="@+id/barra3" android:layout_width="9dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:background="@drawable/barra" android:backgroundTint="@color/gris_barra" />
                        <View android:id="@+id/barra4" android:layout_width="9dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:background="@drawable/barra" android:backgroundTint="@color/gris_barra" />
                        <View android:id="@+id/barra5" android:layout_width="9dp" android:layout_height="10dp" android:background="@drawable/barra" android:backgroundTint="@color/primario" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvAcelMini"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:text="-- m/s²"
                        android:textColor="@color/texto"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGiro"
                style="@style/TarjetaSensor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/TextoEtiqueta" android:text="Giroscopio" />
                    <TextView android:id="@+id/tvGiroMini" style="@style/TextoGrande" android:layout_marginTop="8dp" android:text="0.00" />
                    <TextView style="@style/TextoDescripcion" android:layout_marginTop="0dp" android:text="rad/s" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progresoGiro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        app:indicatorColor="@color/primario"
                        app:trackColor="@color/borde"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- GPS (tarjeta dorada) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGps"
            style="@style/TarjetaSensor"
            app:cardBackgroundColor="@color/primario"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/TextoEtiqueta" android:text="GPS" android:textColor="@color/negro" />
                    <TextView
                        android:id="@+id/tvGpsMini"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:text="Buscando..."
                        android:textColor="@color/negro"
                        android:textSize="15sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Ubicación"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="@color/negro" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextoDescripcion"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Toca una tarjeta para ver el detalle" />
    </LinearLayout>
</ScrollView>
